{
  "name": "koda-monorepo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --filter @koda/web dev",
    "dev:admin": "pnpm --filter @koda/admin dev -p 3001",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint:arch": "pnpm --filter @koda/web lint:arch",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm lint:arch && pnpm typecheck && pnpm test",
    "seed:analytics": "node scripts/seed-analytics.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "^5.8.0"
  }
}
