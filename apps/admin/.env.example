# Mot de passe de l'espace admin (obligatoire en production).
ADMIN_PASSWORD=change-moi
# Secret de signature du cookie de session (32+ caractères aléatoires : `openssl rand -hex 32`). Obligatoire en production.
ADMIN_SECRET=change-moi-aussi-avec-une-longue-chaine-aleatoire
# Postgres : chaîne « Transaction pooler » de Supabase (port 6543). Même valeur que sur la boutique.
# Absent = fichier .data/analytics.jsonl en dev, mémoire en prod.
# DATABASE_URL=postgresql://postgres.xxxx:motdepasse@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Campagnes newsletter : envoi depuis la boîte mail KODA (SMTP). Gmail / Google Workspace : smtp.gmail.com, port 465,
# mot de passe d'application (compte Google → Sécurité → Validation en deux étapes → Mots de passe des applications).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=hello@kodaclothing.fr
# SMTP_PASS=xxxx xxxx xxxx xxxx
# Alternative sans boîte mail : Resend (gratuit : 3 000 mails / mois, 100 / jour), domaine vérifié dans Resend.
# RESEND_API_KEY=re_...
# EMAIL_FROM=KODA Clothing <hello@kodaclothing.fr>
# SHOP_URL=https://kodaclothing.fr
# Temps réel : URL du projet Supabase et clé service_role (jamais exposée au navigateur, relais SSE côté serveur).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Rafraîchissement immédiat de la boutique quand un réglage change (même valeur sur le projet web : REVALIDATE_SECRET).
# SHOP_URL=https://kodaclothing.vercel.app
# REVALIDATE_SECRET=change-me

# Serveur MCP (/api/mcp) : jeton Bearer que les IA (Claude, Cursor…) présentent. `openssl rand -hex 24`.
# MCP_TOKEN=
# ADMIN_URL=https://kodaclothingadmin.vercel.app
