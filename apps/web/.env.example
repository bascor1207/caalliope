# Postgres : chaîne « Transaction pooler » de Supabase (port 6543). Même valeur que sur l'admin.
# Absent = fichier .data/analytics.jsonl en dev, mémoire en prod (événements perdus à chaque déploiement).
# DATABASE_URL=postgresql://postgres.xxxx:motdepasse@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Jeton de l'endpoint de diagnostic /api/analytics/summary (optionnel).
# ADMIN_TOKEN=

# Stripe (achat express Apple Pay / Google Pay / Link sur la fiche produit). Clés de test = aucun débit.
# Les deux sont nécessaires ; sans elles, le bloc n'est simplement pas affiché.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
